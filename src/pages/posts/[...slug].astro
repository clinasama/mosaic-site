---
// SPDX-License-Identifier: MPL-2.0
import { getCollection, render } from 'astro:content';
import MetroLayout from '@/layouts/MetroLayout.astro';
import BackButton from '@/components/BackButton.astro';
import PostLicense from '@/components/PostLicense.astro';
import Comments from '@/components/Comments.astro';
import { formatDate } from '@/utils/date';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const date = formatDate(post.data.published ?? post.data.pubDate);
const readingTime = (remarkPluginFrontmatter as any)?.readingTime;
const coverImage = post.data.image ?? post.data.cover;
const isPinned = post.data.pinned;
const licenseName = post.data.licenseName;
const licenseUrl = post.data.licenseUrl;
const sourceLink = post.data.sourceLink;
const author = post.data.author;
---

<MetroLayout title={`${post.data.title} · mosaic`} description={post.data.description}>
  <article style="max-width:760px;margin:0 auto;padding:72px 24px 96px;line-height:1.8;">
    <BackButton href="/posts/" label="返回文章列表" />

    {isPinned && (
      <span style="display:inline-block;padding:2px 8px;border:1px solid var(--primary);border-radius:2px;font-size:.75rem;margin:16px 0 0;">
        置顶
      </span>
    )}

    <h1 style="font-size:2.2rem;font-weight:300;margin:24px 0 12px;">{post.data.title}</h1>

    <p style="opacity:.55;font-size:.85rem;margin:0 0 40px;">
      {date}
      {author && ` · ${author}`}
      {readingTime && ` · ${readingTime}`}
    </p>

    {coverImage && (
      <img src={coverImage} alt={post.data.title} style="width:100%;margin-bottom:32px;display:block;" />
    )}

    <Content />

    {(licenseName || sourceLink) && (
      <footer style="margin-top:64px;padding-top:24px;border-top:1px solid var(--border-subtle);font-size:.8rem;opacity:.55;">
        {licenseName && (
          <p style="margin:0;">
            许可协议：{licenseUrl ? <a href={licenseUrl} target="_blank" rel="noopener noreferrer">{licenseName}</a> : licenseName}
          </p>
        )}
        {sourceLink && (
          <p style="margin:4px 0 0;">
            原文：<a href={sourceLink} target="_blank" rel="noopener noreferrer">{sourceLink}</a>
          </p>
        )}
      </footer>
    )}
      
    <PostLicense
      author={post.data.author}
      sourceLink={post.data.sourceLink}
      licenseName={post.data.licenseName}
      licenseUrl={post.data.licenseUrl}
      published={post.data.published ?? post.data.pubDate}
    />

    {post.data.comment !== false && <Comments />}
  </article>
</MetroLayout>

<style is:global>
  article :global(a:not(.back-btn)) { color: var(--primary); }
  article :global(img) { max-width: 100%; height: auto; }
  article :global(pre) { background: var(--bg-deep); padding: 16px; overflow-x: auto; }
  article :global(code){ font-size: .9em; }
</style>