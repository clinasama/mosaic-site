<script>
  let Fancybox: any = null;

  function wrapImages() {
    const imgs = document.querySelectorAll(
      'article img, .custom-md img, .prose img'
    );
    imgs.forEach((img) => {
      const el = img as HTMLImageElement;
      if (el.closest('a[data-fancybox]')) return;
      if (el.closest('a.img-lightbox')) return;

      const link = document.createElement('a');
      link.href = el.getAttribute('src') || '';
      link.className = 'img-lightbox';
      link.setAttribute('data-fancybox', 'post');
      link.setAttribute('data-caption', el.getAttribute('alt') || '');
      el.parentNode?.insertBefore(link, el);
      link.appendChild(el);
    });
  }

  async function setup() {
    wrapImages();

    const links = document.querySelectorAll('[data-fancybox="post"]');
    if (!links.length) return;

    if (!Fancybox) {
      const mod = await import('@fancyapps/ui');
      Fancybox = mod.Fancybox;
      await import('@fancyapps/ui/dist/fancybox/fancybox.css');
    }

    try { Fancybox.unbind('[data-fancybox="post"]'); } catch {}
    try { Fancybox.destroy(); } catch {}

    Fancybox.bind('[data-fancybox="post"]', {
      mainStyle: {
        '--f-bg': 'oklch(0.1 0.02 var(--hue) / 0.96)',
        '--f-color': 'var(--text)',
        '--f-button-bg': 'var(--surface)',
        '--f-button-color': 'var(--text)',
        '--f-button-hover-bg': 'var(--primary)',
        '--f-button-hover-color': '#fff',
        '--f-thumb-border': '1px solid var(--border-subtle)',
        '--f-thumb-selected-shadow': 'inset 0 0 0 2px var(--primary)',
        '--f-progress-bg': 'var(--primary)',
      },
      Carousel: {
        infinite: true,
        Navigation: true,
        Thumbs: { type: 'classic' },
        Zoomable: {
          Panzoom: {
            maxScale: 4,
            minScale: 1,
            click: 'toggleZoom',
            dblClick: 'toggleZoom',
            panMode: 'mousemove',
            mouseMoveFactor: 1.1,
            wheel: true,
            pinch: true,
          },
        },
      },
      Toolbar: {
        display: {
          left: ['infobar'],
          middle: ['zoomIn', 'zoomOut', 'toggle1to1', 'rotateCCW', 'rotateCW'],
          right: ['slideshow', 'thumbs', 'close'],
        },
      },
      animated: true,
      dragToClose: false,
      keyboard: { Escape: 'close', Delete: 'close', Backspace: 'close' },
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => {
    try { Fancybox?.destroy(); } catch {}
  });
</script>

<style is:global>
  .fancybox__container {
    --f-bg: oklch(0.1 0.02 var(--hue) / 0.96) !important;
    --f-color: var(--text) !important;
  }
  .fancybox__toolbar,
  .fancybox__nav { color: var(--text) !important; }
  .fancybox__button {
    background: var(--surface) !important;
    border-radius: 0 !important;
    color: var(--text) !important;
  }
  .fancybox__button:hover {
    background: var(--primary) !important;
    color: #fff !important;
  }
  .fancybox__caption {
    color: var(--text-muted) !important;
    font-family: 'Noto Sans Variable', 'Noto Sans SC Variable', sans-serif !important;
  }
  .fancybox__progress { background: var(--primary) !important; }
</style>